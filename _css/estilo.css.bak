@charset "UTF-8";
@font-face {
	font-family: frizquadrata;
	src: url(../_fonts/friz-quadrata-tt.ttf);
}
/* Corpo de Todo o Site */	
	body {
		position: relative;
		width: 1358px;
		height: 700px;
        overflow-x: hidden;
		margin: 0px;
		cursor: url('../cursor2.png'), auto;
}	
/* Banner do Site */	
	figure#banner {
		position: relative;
		width: 1358px;
		height: 230px;
		top: 0px;
		margin: 0px;
}
	figure#banner img {
		width: 100%;
		height: 100%;		
}
/* Imagem de Fundo */	
	div#fundo {
		background-image: url('../_imagens/fundop.jpg');
		background-repeat: no-repeat;
		background-attachment: fixed;
		position: relative;
		width: 1358px;
		height: 700px;
}
	
/* Opções do Menu */	
	nav#menu {
		display: block;
}
	nav#menu img {
		margin: 0px;
		position: absolute;
		left: -1px;
		width: 1351px;
		height: 35px;		
}
	nav#menu ul{
		top: -8px;
		list-style: none;
		position: absolute;
}
	nav#menu li{
		display: inline-block;
		color: white;
}
	nav#menu li#home {
		margin-left: 90px;
}
	nav#menu li#trocas {
		margin-left: 265px;
}
	nav#menu li#inimigos {
		margin-left: 275px;
}
	nav#menu li#mais {
		margin-left: 275px;
}
/* Corpo da Pagina */
	div#corpo {
		position: absolute;
		top: 265px;
		width: 1325px;
		height: 648px;
}
	div#corpo img#fundobranco {
		position: relative;
		width: 100%;
		height: 100%;
		margin: 10px 12px 10px 12px;
}
	div#conteudo {
		position: absolute;
		top: 0px;
		left: 15px;
		padding: 20px;
		font-family: frizquadrata;
}






